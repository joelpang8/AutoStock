# Copy to .env and fill in. Never commit .env.
ALPACA_API_KEY=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret
# Paper unless set to false. Live also needs ALLOW_LIVE_TRADING below,
# which must only be set after the owner approves the first live run.
ALPACA_PAPER=true
# ALLOW_LIVE_TRADING=yes-i-have-owner-approval

# qld_trend (default): hold QLD while QQQ is above its 200-day average, cash
# otherwise, with Claude as a watchdog on buys (trend.py). Needs QLD in the
# allowed tickers and a per-ticker cap of about $300 in guardrails.py.
# claude: Claude picks every trade (lost to holding SPY in the replay test).
STRATEGY=qld_trend

# Anthropic API (decision step)
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-haiku-5-5
DECISION_INTERVAL_MINUTES=5
# Hard daily cap on Claude API spend; the bot holds once it's reached
DAILY_AI_BUDGET_USD=1.00
# SQLite file for events, decisions, orders, alerts and bot state
DB_PATH=autostock.db

# Optional: earnings dates (free key at alphavantage.co; the bot uses 1 request/day)
ALPHAVANTAGE_API_KEY=

# Discord check-in bot (all four, or none for log-only alerts). Setup steps in discord_bot.py.
DISCORD_BOT_TOKEN=
# Right-click server / channel / your name > Copy ID (needs Developer Mode on)
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=

# Dead-man heartbeat: pinged after every cycle (every 5 min in market hours,
# every 15 min outside). Create a free check at healthchecks.io with period
# 15 minutes and grace 10 minutes, and paste its ping URL here.
HEALTHCHECK_URL=
