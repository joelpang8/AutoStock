# Copy to .env and fill in. Never commit .env.
ALPACA_API_KEY=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret
# Paper unless set to false. Live also needs ALLOW_LIVE_TRADING below,
# which must only be set after the owner approves the first live run.
ALPACA_PAPER=true
# ALLOW_LIVE_TRADING=yes-i-have-owner-approval
