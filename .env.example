# Copy to .env and fill in. Never commit .env.
ALPACA_API_KEY=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret
# Paper unless set to false. Live also needs ALLOW_LIVE_TRADING below,
# which must only be set after the owner approves the first live run.
ALPACA_PAPER=true
# ALLOW_LIVE_TRADING=yes-i-have-owner-approval

# Anthropic API (decision step)
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-haiku-5-5
DECISION_INTERVAL_MINUTES=5
# Hard daily cap on Claude API spend; the bot holds once it's reached
DAILY_AI_BUDGET_USD=1.00

# Optional: earnings dates (free key at alphavantage.co; the bot uses 1 request/day)
ALPHAVANTAGE_API_KEY=
